{
  "name": "@vectorfield/pi-prs",
  "version": "0.1.0",
  "description": "Fork of pi-prs: GitHub pull request feedback/watching with explicit PR URL or number targeting. Lets /pr watch follow a release PR (e.g. dev->main) from any session cwd.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "github",
    "pull-request",
    "code-review",
    "release"
  ],
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && node --test --experimental-strip-types src/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
